# ── Versions ──────────────────────────────────────────────────
OPENSEARCH_VERSION=2.17.0
HADOOP_VERSION=3.3.6

# ── Credentials (dev only — k8s Secrets in prod) ──────────────
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin_password_1!

# ── Heap sizes (50% of container RAM) ─────────────────────────
OS_MASTER_HEAP=1g
OS_DATA_HEAP=2g
LS_HEAP_SIZE=1g
HDFS_NAMENODE_HEAP=1g
HDFS_DATANODE_HEAP=1g
YARN_RM_HEAP=1g
YARN_NM_HEAP=1g

# ── Cluster ───────────────────────────────────────────────────
OPENSEARCH_CLUSTER_NAME=opensearch-cluster
HDFS_CLUSTER_NAME=hdfs-cluster
YARN_CLUSTER_NAME=yarn-cluster
K8S_NAMESPACE=data-platform

# ── Provider: gcp | aws | azure | local ───────────────────────
PROVIDER=gcp
